# ╔══════════════════════════════════════════════════════════════╗
# ║         GLAMFLOW — Environment Configuration                ║
# ║  Copy this file to .env and fill in your actual values      ║
# ╚══════════════════════════════════════════════════════════════╝

# ── INSTAGRAM (Meta Graph API) ─────────────────────────────────
# Your Instagram Business Account numeric ID
# Get it from: https://developers.facebook.com/tools/explorer
# Call: GET /me/accounts → then GET /{page-id}?fields=instagram_business_account
IG_USER_ID=your_instagram_business_account_id

# Long-lived access token (valid 60 days, auto-refreshed monthly by cron)
# Get via: https://developers.facebook.com/tools/explorer
# Exchange short-lived → long-lived using the /api/token/exchange endpoint
IG_TOKEN=your_long_lived_access_token

# Meta App credentials (needed for token exchange/refresh)
IG_APP_ID=your_meta_app_id
IG_APP_SECRET=your_meta_app_secret

# ── ANTHROPIC (AI Content Generation) ─────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── CLOUDINARY (Image Hosting) ────────────────────────────────
# Free tier: 25GB storage + 25GB bandwidth/month
# Sign up at: https://cloudinary.com
# Create an upload preset named "glamflow" (unsigned, in Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ── SERVER ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
